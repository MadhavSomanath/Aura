# Aura talks to any OpenAI-compatible AI endpoint. Copy this file to .env and fill it in.

# Your API key. With no key and no AI_BASE_URL, the AI features show "AI is not set up".
AI_API_KEY="your-key-here"

# Optional: which model to use. Defaults to gemini-3.8-flash.
# AI_MODEL="gemini-3.8-flash"

# Optional: the endpoint. Defaults to Gemini's OpenAI-compatible URL.
# Examples:
#   OpenAI      https://api.openai.com/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://localhost:11434/v1   (no key needed)
# AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
